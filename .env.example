# Cloudinary configuration
# Create a free account at https://cloudinary.com, then:
# 1. Copy your Cloud Name from the Dashboard.
# 2. Go to Settings -> Upload -> Upload presets -> Add upload preset.
#    Set "Signing Mode" to "Unsigned" and save. Copy its name below.
# 3. Choose a root folder name to keep your uploads organized (created automatically).

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_FOLDER=tjs-site
